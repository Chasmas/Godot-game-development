 "npcs": {
  "13,28": {
   "id": "earl",
   "palette": "civilian",
   "lines": [
    "Room's paid through Sunday. I'm not moving for anybody.",
    "Harcourt's been jumpy all week. Keeps checking the parking lot like he's waiting for somebody.",
    "Room 204? Tape starts by itself after midnight. Same scream, same fire, every night."
   ]
  },
  "13,3": {
   "id": "dolores",
   "palette": "scout",
   "lines": [
    "Housekeeping stopped servicing this floor months ago, honey. Manager's orders.",
    "Harcourt keeps 204 locked even when it's empty. Sometimes I hear a projector through the wall.",
    "If you're looking for him, try the office. If you're looking for answers... don't let him see you asking."
   ]
  }
 },
 "collectibles": {
  "48,7": {
   "id": "tape_roll7",
   "kind": "tape",
   "title": "VHS: HOTSHOT \u2014 CAMERA B / ROLL 7",
   "text": "Unedited stunt footage. A Cadillac burns on a desert road. Cass walks out of frame, coughing. Tommy is still inside the car.\nA voice behind the camera says: 'Don't cut. Aurelio wants the whole take.'\nThe image buckles into static."
  },
  "63,3": {
   "id": "photo_harcourt",
   "kind": "photo",
   "title": "POLAROID: HOTSHOT WRAP PARTY \u2014 1987",
   "text": "Harcourt, younger, wearing a HOTSHOT crew jacket. Beside him stands a man whose face has been gouged away with a key.\nOn the back, in blue ink: 'A.V. knows who changed the fire gag. Residuals due.'"
  }
