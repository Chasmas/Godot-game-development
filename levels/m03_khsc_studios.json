 "npcs": {
  "57,20": {
   "id": "rudy",
   "palette": "civilian",
   "lines": [
    "I'm not here. I'm a coat rack. Coat racks don't testify.",
    "Mr. Kowalski's on the Cadillac. He's been talking to it.",
    "The booth said you'd come in through the elephant doors. They had a whole shot planned."
   ]
  },
  "4,2": {
   "id": "bev",
   "palette": "scout",
   "lines": [
    "Hold still, your star's smudged. ...Sorry. Habit.",
    "They made me paint twenty of those stars tonight. For the extras. The extras didn't come back."
   ]
  }
 },
