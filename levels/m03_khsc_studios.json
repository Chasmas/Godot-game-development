 "npcs": {
  "57,20": {
   "id": "rudy",
   "palette": "civilian",
   "lines": [
    "I'm not here. I'm a coat rack. Coat racks don't testify.",
    "Mr. Kowalski's on the Cadillac. He's been talking to it.",
